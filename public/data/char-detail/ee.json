[{"char":"目","pronunciations":[{"pinyin":"mù","explanations":[{"content":"（象形。甲骨文和小篆字形。象眼睛形，外边轮廓象眼眶，里面象瞳孔。小篆处理为线条。先秦时期多用“目”，两汉以后，用眼逐渐多起来。“目”具有书面语色彩。本义：眼睛）。"},{"content":"同本义。","detail":[{"text":"目，人眼，象形。","book":"《说文》"},{"text":"目者，气之清明者也。","book":"《礼记·郊特牲。》"},{"text":"目者，心之符也。","book":"《韩诗外传》"},{"text":"夫妻反目。","book":"《易·小畜卦》"},{"text":"睅其目，皤其腹。","book":"《左传·宣公二年》"},{"text":"满目萧然。","book":"宋·范仲淹《岳阳楼记》"},{"text":"瞋目大怒。","book":"晋·干宝《搜神记》"},{"text":"目似瞑。","book":"《聊斋志异·狼三则》"},{"text":"目不忍睹。","book":"清·薛福成《观巴黎油画记》"}],"words":[{"word":"目不斜视","text":"眼睛不向旁边看，形容为人正派"},{"word":"目见耳闻","text":"亲眼看见，亲耳听到"},{"word":"目治手营","text":"亲眼观察，亲手试验"},{"word":"目空一世","text":"什么都不放在眼里。形容骄傲自大"},{"word":"目眩神摇","text":"眼花缭乱，心神摇荡"},{"word":"目无下尘","text":"眼睛不朝下看。形容态度高傲。下尘，下风，喻指比自己低下的人"},{"word":"目耗","text":"眼睛昏花"},{"word":"目指","text":"用眼睛示意指点"},{"word":"目眦","text":"眼眶"},{"word":"目珠","text":"眼球"},{"word":"目睛","text":"眼珠"},{"word":"目精","text":"眼珠；眼睛"}]},{"content":"目光；眼力。","detail":[{"text":"四海注目。","book":"《晋书·孙惠传》"}],"words":[{"word":"目捷","text":"目光敏捷"},{"word":"目击道存","text":"眼光一接触便知“道”之所在。形容悟性好"},{"word":"目色","text":"视力"},{"word":"目使颔令","text":"用眼色和下颔示意以役使别人。形容态度骄横"},{"word":"目注","text":"目光注视"},{"word":"目波","text":"水波似的目光、谓目光流盼如水波"},{"word":"目逆","text":"以目光相迎"},{"word":"目极","text":"用尽目力远望"}]},{"content":"孔眼。","detail":[{"text":"举一纲而万目张。","book":"郑玄《诗谱序》"}],"words":[{"word":"纲举目张；一个60目的筛"}]},{"content":"首领；头目。","detail":[{"text":"夷目嘉符。","book":"《广东军务记》"}],"words":[{"word":"目把","text":"指西南少数民族中的小首领"}]},{"content":"名目，数目；行列。","detail":[{"text":"不在使者之目。","book":"宋·文天祥《后序》"}]},{"content":"观看，注视。","detail":[{"text":"指目陈胜。","book":"《史记·陈涉世家》"},{"text":"指目牵引。","book":"唐·柳宗元《柳河东集》"}],"words":[{"word":"目过","text":"过目；细看"},{"word":"目下十行","text":"形容看书速度极快"},{"word":"目及","text":"看到"},{"word":"目染","text":"因经常看见而受到影响"},{"word":"目笑","text":"目视而窃笑"},{"word":"目礼","text":"以目注视，表示敬意"},{"word":"目断","text":"犹望断。一直望到看不见"},{"word":"目识","text":"看后即记住"},{"word":"目属","text":"瞩目；注视"},{"word":"目艳","text":"看到美好的事物而感到羡慕"},