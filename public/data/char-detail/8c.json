ail":[{"text":"厌，笮也。","book":"《说文》。段注：“此义今人字作压，乃古今字之殊。”"},{"text":"地震陇西，厌四百余家。","book":"《汉书·五行志下之上》"},{"text":"如墙厌之。","book":"《荀子·彊国》"},{"text":"厌目而视者，视一以为两。","book":"《荀子·解蔽》"}],"words":[{"word":"厌覆","text":"车翻人压"}]},{"content":"泛指压制；抑制。","detail":[{"text":"东厌诸侯之权，西远羌胡之难。——《汉书·翼奉传》。——师古曰：“厌，抑也。”"},{"text":"故贤人立朝，折冲厌难，胜于亡形。","book":"《汉书·辛庆忌传》。师古曰：“厌，抑也。”"}],"words":[{"word":"厌抑","text":"压制"}]},{"content":"以迷信的方法，镇服或驱避可能出现的灾祸，或致灾祸于人。","detail":[{"text":"秦始皇帝常曰：“东南有天子气”，于是因东游以厌之。","book":"《史记·高祖纪》"}],"words":[{"word":"厌法","text":"厌胜法。是一种用咒符来制服对手的巫术"}]},{"content":"堵塞。","detail":[{"text":"厌其源，开其渎。","book":"《荀子·修身》。注：“厌，塞也。”"}]}]},{"pinyin":"yàn","explanations":[{"content":"（形声。从厂（hǎn），猒（yàn）声。厂，象山崖石穴形。《说文》：“厌，笮也。”意思是“压”。由“犬、肉、甘”三部分合起来，会意，表示“吃饱”、“满足”。本义：吃饱）。"},{"same":"餍","content":"饱，满足","detail":[{"text":"学而不厌，诲人不倦，何有于我哉？","book":"《论语》"},{"text":"不厌。","book":"《左传·僖公三十三年》"},{"text":"秦之欲无厌。","book":"宋·苏洵《六国论》"},{"text":"求之者无厌。","book":"宋·苏轼《教战守》"}],"words":[{"word":"厌极","text":"满足穷尽"},{"word":"厌饫","text":"吃饱；吃腻；满足"},{"word":"厌塞","text":"满足"},{"word":"厌伪","text":"对奸邪巧伪感到满意"},{"word":"厌恋","text":"以此为满足而眷恋"},{"word":"厌副","text":"满足"},{"word":"厌足","text":"满足"}]},{"content":"憎恶；嫌弃。","detail":[{"text":"人常厌事。","book":"清·梁启超《谭嗣同传》"},{"text":"惟厌事也。"},{"text":"犹厌言兵。","book":"宋·姜夔《扬州慢》"},{"text":"无厌其为迂。","book":"明·宗臣《报刘一丈书》"},{"text":"这儿我住厌了。","book":"曹禺《雷雨》"}],"words":[{"word":"厌世","text":"现世；出丑露乖"},{"word":"厌厌地","text":"无精打采地；微弱的样子"},{"word":"厌物","text":"骂人话，指讨人厌的东西"},{"word":"厌钝","text":"讨厌，扫兴"},{"word":"厌色","text":"厌烦、不满的脸色"},{"word":"厌苦","text":"厌烦以为苦事"}]}]}],"index":386},{"char":"肌","pronunciations":[{"pinyin":"jī","explanations":[{"content":"（形声。从肉，几声。本义：肌肉）。"},{"content":"同本义（先秦时期，“肌”表示人的肉；“肉”表示禽兽的肉）。","detail":[{"text":"肌，肉也。","book":"《说文》"},{"text":"度制，肌肤血气之情也。","book":"《春秋繁露》"},{"text":"病在肌肤。","book":"《韩非子·喻老》"},{"text":"乃割皮解肌，诀脉结筋。","book":"《史记·扁鹊列传》"}],"words":[{"word":"肌肥骨重","text":"形容身躯壮实魁悟"},{"word":"肌肌","text":"肌肉强直的样子"},{"word":"肌肪","text":"肌肤"},{"word":"肌革","text