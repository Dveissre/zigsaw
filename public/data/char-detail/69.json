》"},{"text":"夺其物。"}],"words":[{"word":"物外","text":"有形事物之外"},{"word":"物变","text":"事物变化"},{"word":"物隐","text":"事物的隐秘"},{"word":"物端","text":"东西，物品"},{"word":"物诱","text":"为外物所引诱"},{"word":"物势","text":"事物的趋势、态势"},{"word":"物惑","text":"外物的诱惑"},{"word":"物则","text":"事物的法则"},{"word":"物像","text":"样子"}]},{"content":"事；事情。","detail":[{"text":"有物有则。","book":"《诗·大雅·烝民》。传：“事也。”"}],"words":[{"word":"物务","text":"事务"},{"word":"物事","text":"事情"},{"word":"物格","text":"事理得到穷究"}]},{"content":"社会，外界环境。","detail":[{"text":"君子生非异也。善假于物也。","book":"《荀子·劝学》"}],"words":[{"word":"物外人","text":"尘世以外的人"},{"word":"物道","text":"世道"},{"word":"物运","text":"世运"},{"word":"物外交","text":"超世脱俗的交谊"}]},{"content":"杂色牛。","detail":[{"text":"三十维物，尔牲则具。","book":"《诗·小雅·无羊》。毛传：“异毛色者三十也。”"}]},{"content":"杂色的旗。","detail":[{"text":"［九旗］ 杂帛为物，以杂色缀其边为燕尾，将帅所建，象物杂色也。","book":"《释名》"},{"text":"司常掌九旗之物品，各有属以待国事：日月为常，旃龙为旂，通帛为旃，杂帛为物…。","book":"《周礼》"}]},{"content":"牲畜的种类、 品级。","detail":[{"text":"辨六马之属，种马一物，戎马一物……驽马一物。","book":"《周礼》"}],"words":[{"word":"物类","text":"同类，物的同类；种类"},{"word":"物汇","text":"物类"}]},{"content":"颜色。","detail":[{"text":"比物四骊。","book":"《诗·小雅·六月》"}],"words":[{"word":"物采","text":"色彩"}]},{"content":"哲学用语。物质，与“心”相对。","detail":[{"text":"自其不变者而观之，则物与我皆无尽也。","book":"苏轼《赤壁赋》"}],"words":[{"word":"唯物论；物气","text":"物质性的妖气"},{"word":"物观","text":"客观"}]},{"content":"物产。","detail":[{"text":"此物故非西产。","book":"《聊斋志异·促织》"}],"words":[{"word":"物图","text":"物产分布图"},{"word":"物殷俗阜","text":"物产丰盛，风俗淳厚"},{"word":"物阜民康","text":"物产丰富，人民安康"},{"word":"物阜","text":"物产丰盛"}]},{"content":"他人；众人。","detail":[{"text":"损己以利物。","book":"唐·魏征《十渐不克终疏》"}],"words":[{"word":"物听","text":"众人的言论"},{"word":"物意","text":"众人的心意"},{"word":"物师","text":"众人的师表"},{"word":"物鬼","text":"人鬼"},{"word":"物迹","text":"人迹"},{"word":"物轨","text":"众人的榜样"},{"word":"物宗","text":"众人所景仰的人"},{"word":"物和","text":"人和"},{"word":"物物","text":"人对于万物的役使、支配"},{"word":"物忌","text":"众人忌惮或忌妒"},{"word":"物心","text":"人心"},{"word":"物望","text":"人望；众望"}]},{"content":"神灵。","detail":[{"text":"辑江淮物，会大海气，以合泰山。","bo