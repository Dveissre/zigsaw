[{"char":"人","pronunciations":[{"pinyin":"rén","explanations":[{"content":"（象形。甲骨文字形，象侧面站立的人形。“人”是汉字部首之一。本义：能制造工具改造自然并使用语言的高等动物）。"},{"content":"同本义。","detail":[{"text":"人，天地之性最贵者也。此籀文象臂胫之形。","book":"《说文》"},{"text":"故人者，天地之德，阴阳之交，鬼神之会，五行之秀气也。故人者，天地之心也，五行之端也，食味，别声，被色，而生者也。","book":"《礼记·礼运》"},{"text":"有七尺之骸、手足之异，戴发含齿，倚而食者，谓之人。","book":"《列子·黄帝》"},{"text":"人未有不乐为治平之民者也。","book":"清·洪亮吉《治平篇》"}],"words":[{"word":"人王","text":"人中之王"},{"word":"人满","text":"人多"},{"word":"人寰","text":"人世"},{"word":"人欲","text":"人的嗜欲"},{"word":"人人言","text":"人的评论"},{"word":"人色","text":"人的正常面色"},{"word":"人头号令","text":"用人头示众以示儆戒"},{"word":"人淘里","text":"人群里"}]},{"content":"某人；某种人；某些人。","detail":[{"text":"劳心者治人，劳力者治于人。","book":"《孟子·滕文公上》"},{"text":"智伯说，又令人请地于魏。","book":"《韩诽 子·十过》"}],"words":[{"word":"人兵","text":"兵马"},{"word":"猎人"},{"word":"主持人"},{"word":"盲人"},{"word":"工人"},{"word":"介绍人"},{"word":"行人"},{"word":"证人"},{"word":"法人"}]},{"content":"别人，他人。","detail":[{"text":"与人罕言语。","book":"明·魏禧《大铁椎传》"}],"words":[{"word":"人去不中留","text":"本人坚决要离去，他人要留是留不住的"},{"word":"人皆下之","text":"人家都瞧不起他"},{"word":"人物","text":"别人的东西"},{"word":"人我","text":"他人与我"},{"word":"人言","text":"别人的评议"}]},{"content":"民，百姓。","detail":[{"text":"吴广素爱人。","book":"《史记·陈涉世家》"},{"text":"为天下人谋永福也。","book":"清·林觉民《与妻书》"}],"words":[{"word":"人帐","text":"常人"},{"word":"人佚","text":"民佚"},{"word":"人黎","text":"平民，百姓"},{"word":"人听","text":"即民听，指老百姓的视听"},{"word":"人上","text":"众人之上"},{"word":"人宗","text":"众人的楷模"},{"word":"人等","text":"众人，许多人"}]},{"content":"指成年人。","detail":[{"text":"以一人生三计之。","book":"清·洪亮吉《治平篇》"}],"words":[{"word":"人种","text":"能传种接代的男人"}]},{"content":"伴侣。","detail":[{"text":"上与神明为友，下与造化为人。","book":"《淮南子》"}]},{"same":"仁","content":"果仁","detail":[{"text":"核者，人也。古曰核，今曰人。","book":"《尔雅·释木》郝懿行义疏"}]},{"same":"仁","content":"仁爱。","detail":[{"text":"谓之好人。","book":"《管子·侈靡》"},{"text":"术礼义而情爱人。","book":"《荀子·修身》"},{"text":"故君子责人则以人，责己则以义。","book":"《吕氏春秋·举难》"}]},{"content":"每人  一定人群中的每一个。","detail":[{"text":"人皆贺之。","book":"《淮南子·人间训》"}],"words":[{"word":"人人","text