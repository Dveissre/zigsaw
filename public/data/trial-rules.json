    "byland-water": {
      "id": "byland-water",
      "name": "奇境：涉沧澜",
      "english": "Eagre",
      "description": {
        "public": "道中关卡额外出现 1 张、守幕关卡出现 2 张不同的「水 / 氵 / 冫 / 雨」干扰卡；题目答案及可用拆法不含这些部件。干扰卡可能组成其他汉字，但提交这些字会判错。",
        "internal": "普通题加入 1 张、BOSS 加入 2 张不同且来自水、氵、冫、雨类别的干扰卡。所有候选拆法都必须完全排除该类别；允许干扰卡与答案卡组成其他汉字，但判题只接受本题目标答案。"
      },
      "stars": 1,
      "icon": "byland-water.svg",
      "family": {
        "id": "byland",
        "weight": 1,
        "variantWeight": 1
      },
      "timing": {
        "normalSeconds": 30,
        "bossSeconds": 90,
        "normalMultiplier": 1,
        "bossMultiplier": 1
      },
      "selection": {
        "excludedComponents": ["水", "氵", "冫", "雨"],
        "normal": {
          "partLengths": [2, 3, 4, 5, 6, 7, 8, 9, 10]
        },
        "boss": {
          "answerCount": 2,
          "partLengths": [2, 3, 4, 5, 6],
          "totalParts": [6, 8]
        }
      },
      "policy": {
        "prompt": {
          "normal": { "mode": "answer-components" },
          "boss": { "mode": "answer-components" }
        },
        "answer": {
          "normal": {
            "input": "character",
            "acceptance": "answer-compatibility",
            "unique": false
          },
          "boss": {
            "input": "character",
            "acceptance": "answer-compatibility",
            "unique": false,
            "distinct": true
          }
        },
        "cards": {
          "normal": {
            "sources": ["answer", "decoy"],
