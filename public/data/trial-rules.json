        "id": "byland",
        "weight": 1,
        "variantWeight": 1
      },
      "timing": {
        "normalSeconds": 30,
        "bossSeconds": 90,
        "normalMultiplier": 1,
        "bossMultiplier": 1
      },
      "selection": {
        "excludedComponents": ["水", "氵", "冫", "雨"],
        "normal": {
          "partLengths": [2, 3, 4, 5, 6, 7, 8, 9, 10]
        },
        "boss": {
          "answerCount": 2,
          "partLengths": [2, 3, 4, 5, 6],
          "totalParts": [6, 8]
        }
      },
      "policy": {
