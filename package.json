{
  "name": "zigsaw",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "predev": "npm run sync:wordlists && npm run build:component-usage && npm run build:atlas && npm run analyze:trial-rule-pools && npm run build:composition-pools",
    "build": "tsc && vite build",
    "prebuild": "npm run sync:wordlists && npm run build:component-usage && npm run build:atlas && npm run analyze:trial-rule-pools && npm run build:composition-pools",
    "build:atlas": "node scripts/build-atlas-index.mjs",
    "build:component-usage": "node scripts/build-component-usage.mjs",
    "sync:wordlists": "node scripts/sync-wordlists.mjs",
    "build:trial-reports": "node scripts/build-trial-rule-reports.mjs",
    "build:component-font": "node scripts/build-component-font.mjs",
    "build:details": "node scripts/build-char-detail-shards.mjs",
    "build:school": "node scripts/build-school-index.mjs",
    "analyze:trial-rule-pools": "node scripts/analyze-trial-rule-pools.mjs",
    "build:composition-pools": "node scripts/build-composition-pools.mjs",
    "preview": "vite preview",
    "pretest": "npm run check:trial-rules",
    "test": "vitest run",
    "pretest:trial": "npm run check:trial-rules",
    "test:trial": "vitest run tests/trial.test.ts tests/trial-runtime-data.test.ts tests/trial-rule-helpers.test.ts tests/debug-auth.test.ts tests/data.test.ts",
    "test:watch": "vitest",
    "check:trial-rules": "node scripts/check-trial-rules.mjs",
    "apply:trial-rules-opinion": "node scripts/apply-trial-rule-opinion.mjs",
    "check:viewports": "node scripts/check-viewports.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
