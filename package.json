{
  "name": "zigsaw",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "predev": "npm run build:component-usage && npm run build:atlas",
    "build": "tsc && vite build",
    "prebuild": "npm run build:component-usage && npm run build:atlas",
    "build:atlas": "node scripts/build-atlas-index.mjs",
    "build:component-usage": "node scripts/build-component-usage.mjs",
    "build:component-font": "node scripts/build-component-font.mjs",
    "build:details": "node scripts/build-char-detail-shards.mjs",
    "build:school": "node scripts/build-school-index.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:viewports": "node scripts/check-viewports.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
